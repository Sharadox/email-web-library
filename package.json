{
  "name": "@sharadox/email-web-library",
  "version": "0.7.0",
  "description": "Send email from web applications through any SMTP server, with message checks and clear errors.",
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "homepage": "https://github.com/Sharadox/email-web-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharadox/email-web-library.git"
  },
  "bugs": "https://github.com/Sharadox/email-web-library/issues",
  "keywords": [
    "email",
    "smtp",
    "nextjs",
    "server-actions",
    "contact-form"
  ],
  "type": "module",
  "exports": {
    ".": {
      "sharadox-source": "./source/index.ts",
      "types": "./distribution/index.d.ts",
      "default": "./distribution/index.js"
    },
    "./*/type": {
      "sharadox-source": "./source/*/type.ts",
      "types": "./distribution/*/type.d.ts"
    },
    "./*": {
      "sharadox-source": [
        "./source/*/index.ts"
      ],
      "types": "./distribution/*/index.d.ts",
      "default": "./distribution/*/index.js"
    }
  },
  "files": [
    "distribution",
    "LICENCA.md",
    "LICENSE.md",
    "NOTICE.md",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.34.9",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "library-build",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:benchmark": "vitest bench --run --passWithNoTests",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit test:benchmark build",
    "prepare": "turborepo-configuration library && (husky || true)"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1175.0",
    "@sharadox/web-library": "^0.11.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.21",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@sharadox/es-lint-configuration-web-library": "^0.1.2",
    "@sharadox/library-build-web-library": "^0.2.0",
    "@sharadox/prettier-configuration-web-library": "^0.1.1",
    "@sharadox/turborepo-configuration-web-library": "^0.1.3",
    "@sharadox/type-script-configuration-web-library": "^0.2.2",
    "@sharadox/vitest-configuration-web-library": "^0.2.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "9.39.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "smtp-server": "^3.21.7",
    "turbo": "^2.11.13",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
